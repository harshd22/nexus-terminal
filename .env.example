# =============================================
# NEXUS TERMINAL — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# --- Application ---
APP_ENV=development           # development | production
APP_SECRET_KEY=change-me-to-a-random-string
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///./nexus_terminal.db

# PostgreSQL (uncomment to switch)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexus_terminal

# --- Kite Connect (Zerodha) ---
# Leave blank to run in Demo Mode
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:8000/api/kite/callback

# --- Screener.in (optional auth for full data) ---
SCREENER_SESSION_COOKIE=

# --- AI Provider ---
# Ollama (local, recommended)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI fallback (optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- News Providers ---
# RSS feeds are public — no keys needed
# Add any additional news API keys below
# NEWSAPI_KEY=

# --- Cache ---
CACHE_TTL_SECONDS=300         # 5 min default
BREADTH_POLL_INTERVAL=30      # seconds

# --- PDF Export ---
# Playwright is used server-side for PDF generation
PLAYWRIGHT_HEADLESS=true

# --- Market Hours (IST) ---
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30

# --- Frontend URL ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=NEXUS TERMINAL
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_DEMO_MODE=true    # Set false when Kite is connected
